@{
    ViewData["Title"] = "Sales Orders";
}

<div class="main-content-container overflow-hidden">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4 mt-1">
        <h3 class="mb-0">
            Sales Orders
        </h3>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb align-items-center mb-0 lh-1">
                <li class="breadcrumb-item">
                    <a class="d-flex align-items-center text-decoration-none" href="index.html">
                        <i class="ri-home-8-line fs-15 text-primary me-1"></i>
                        <span class="text-body fs-14 hover">Dashboard</span>
                    </a>
                </li>
                <li aria-current="page" class="breadcrumb-item active">
                    <span>Inventory</span>
                </li>
                <li aria-current="page" class="breadcrumb-item active">
                    <span class="text-secondary">Sales Orders</span>
                </li>
            </ol>
        </nav>
    </div>

    <div class="card bg-white rounded-10 border border-white mb-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 p-20">
            <form class="table-src-form position-relative m-0" onsubmit="return false;">
                <input class="form-control w-350" placeholder="Search sales order..." type="text" id="searchInput" />
            </form>
        </div>

        <div class="default-table-area mx-minus-1 table-to-do-list">
            <div class="table-responsive">
                <table class="table align-middle w-100" id="salesOrderTable">
                    <thead>
                        <tr>
                            <th class="fw-medium" scope="col" style="width: 50px;">
                                <div class="form-check">
                                    <input class="form-check-input" id="checkAll" type="checkbox" />
                                </div>
                            </th>
                            <th class="fw-medium" scope="col">Order ID</th>
                            <th class="fw-medium" scope="col">Dealer</th>
                            <th class="fw-medium" scope="col">Items</th>
                            <th class="fw-medium" scope="col">Sub Total</th>
                            <th class="fw-medium" scope="col">Tax</th>
                            <th class="fw-medium" scope="col">Total</th>
                            <th class="fw-medium" scope="col">Date</th>
                            <th class="fw-medium" scope="col">Status</th>
                            <th class="fw-medium" scope="col" style="width: 120px;">Action</th>
                        </tr>
                    </thead>
                    <tbody id="orderTableBody">
                        <!-- Orders will be dynamically rendered here -->
                    </tbody>
                </table>
            </div>

            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 showing-wrap pt-15 p-20">
                <span class="fs-15" id="entriesInfo">
                    Showing 0 to 0 of 0 entries
                </span>
                <nav aria-label="Page navigation example" class="custom-pagination">
                    <ul class="pagination mb-0 justify-content-center" id="paginationControls">
                        <!-- Pagination will be dynamically rendered here -->
                    </ul>
                </nav>
            </div>
        </div>
    </div>

    <!-- Process Order Modal -->
    <partial name="_processSalesOrderPartial" />
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/js/SalesOrderController.js"></script>

<script type="text/javascript">
    $(function () {
        var ctrl = new SalesOrderController();
        ctrl.init();
    });
</script>