@using BPM.Web.Distributor.UI.Models.ViewModels
@model ForgotPasswordViewModel

@{
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
    ViewData["Title"] = "Forgot Password";
}

<div class="login-wrapper">

    <div class="auth-container">

        <!-- LEFT PANEL -->
        @await Html.PartialAsync("_AuthLeftPanel")

        <!-- RIGHT PANEL -->

        <div class="auth-form-section">

            <div class="auth-card">

                <div class="form-header">

                    <div class="welcome-badge">

                        <i class="bi bi-key"></i>

                        <span>Recover your account</span>

                    </div>

                    <h1>Forgot Password?</h1>

                    <p>
                        Enter your username to receive a password reset link.
                    </p>

                </div>

                <form id="formForgotPassword">

                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>

                    <!-- Username -->

                    <div class="form-group">

                        <label asp-for="Username"
                               class="form-label">
                        </label>

                        <div class="input-group">

                            <span class="input-group-text">

                                <i class="bi bi-person"></i>

                            </span>

                            <input asp-for="Username"
                                   id="username"
                                   class="form-control"
                                   placeholder="Enter your username" />

                        </div>

                        <span asp-validation-for="Username"
                              class="text-danger">
                        </span>

                    </div>

                    <!-- Button -->

                    <button id="btnSubmit"
                            type="button"
                            class="btn btn-primary w-100">

                        Send Reset Link

                        <i class="bi bi-arrow-right-circle ms-2"></i>

                    </button>

                </form>

                <div class="divider">

                    <span>Remember your password?</span>

                </div>

                <div class="text-center">

                    <a asp-controller="Account"
                       asp-action="Login"
                       class="forgot-link">

                        <i class="bi bi-arrow-left"></i>

                        Back to Login

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script src="~/assets/js/Application/ForgotPasswordController.js"></script>

    <script>

        $(function () {

            var controller = new ForgotPasswordController();

            controller.init();

        });

    </script>

}