@model ForgotPasswordViewModel

@{
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
    ViewData["Title"] = "Forgot Password";
}

<div class="login-wrapper">

    <div class="auth-container">

        <!-- LEFT PANEL -->

        <div class="auth-image-section">

            <img src="~/assets/images/png/drug_landing.jpg"
                 class="auth-image"
                 alt="Drug Landing" />

            <div class="image-overlay">

                <div class="image-content">

                    <div class="brand-large">

                        <div class="brand-icon-large">
                            <i class="bi bi-hexagon-fill"></i>
                            <i class="bi bi-grid-1x2-fill"></i>
                        </div>

                        <h1 class="brand-name">
                            BPM<span>Medicals</span>
                        </h1>

                        <p class="brand-tagline">
                            Enterprise Medical Dealer Platform
                        </p>

                    </div>

                    <div class="image-features">

                        <div class="feature-item">

                            <div class="feature-icon">
                                <i class="bi bi-shield-check"></i>
                            </div>

                            <div class="feature-text">

                                <h4>Secure Access</h4>

                                <p>
                                    Enterprise-grade security with end-to-end encryption.
                                </p>

                            </div>

                        </div>

                        <div class="feature-item">

                            <div class="feature-icon">
                                <i class="bi bi-key"></i>
                            </div>

                            <div class="feature-text">

                                <h4>Password Recovery</h4>

                                <p>
                                    Securely reset your password in just a few steps.
                                </p>

                            </div>

                        </div>

                        <div class="feature-item">

                            <div class="feature-icon">
                                <i class="bi bi-clock-history"></i>
                            </div>

                            <div class="feature-text">

                                <h4>Quick Recovery</h4>

                                <p>
                                    Get back to work with our fast password reset process.
                                </p>

                            </div>

                        </div>

                    </div>

                    <div class="testimonial">

                        <div class="testimonial-quote">

                            <i class="bi bi-quote"></i>

                            <p>

                                "Quick and secure password recovery process."

                            </p>

                        </div>

                        <div class="testimonial-author">

                            <img src="https://via.placeholder.com/40"
                                 class="author-avatar" />

                            <div>

                                <strong>Sarah Johnson</strong>

                                <span>IT Director, InnovateCorp</span>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <!-- RIGHT PANEL -->

        <div class="auth-form-section">

            <div class="auth-card">

                <div class="form-header">

                    <div class="welcome-badge">

                        <i class="bi bi-arrow-left-circle"></i>

                        <span>Reset your password</span>

                    </div>

                    <h1>

                        Forgot Password?

                    </h1>

                    <p>

                        Enter your email address and we'll send you a link to reset your password.

                    </p>

                </div>

                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger">

                        <i class="bi bi-exclamation-triangle-fill me-2"></i>

                        @TempData["Error"]

                    </div>
                }

                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success">

                        <i class="bi bi-check-circle-fill me-2"></i>

                        @TempData["Success"]

                    </div>
                }

                <form id="forgotPasswordForm"
                      asp-action="ForgotPassword"
                      asp-controller="Account"
                      method="post">

                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3"></div>

                    <div class="form-group">

                        <label asp-for="Username"
                               class="form-label">

                            Email Address

                        </label>

                        <div class="input-group">

                            <span class="input-group-text">

                                <i class="bi bi-envelope"></i>

                            </span>

                            <input asp-for="Username"
                                   class="form-control"
                                   placeholder="Enter your email address"
                                   autocomplete="off" />

                        </div>

                        <span asp-validation-for="Username"
                              class="text-danger"></span>

                    </div>

                    <button id="btnSubmit"
                            type="submit"
                            class="btn btn-primary w-100">

                        Send Reset Link

                        <i class="bi bi-arrow-right-circle ms-2"></i>

                    </button>

                </form>

                <div class="divider">

                    <span>Need Help?</span>

                </div>

                <div class="social-login">

                    <p class="text-muted small text-center">

                        <i class="bi bi-question-circle me-1"></i>

                        Having trouble?

                        <a href="#"
                           class="text-primary text-decoration-none">

                            Contact our support team

                        </a>

                    </p>

                </div>

                <div class="auth-footer mt-4">

                    <p>

                        <a asp-action="Login"
                           asp-controller="Account"
                           class="text-decoration-none">

                            <i class="bi bi-arrow-left"></i>

                            Back to Login

                        </a>

                    </p>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    <script src="~/assets/js/Application/ForgotPasswordController.js"></script>

    <script>

        $(function () {

            var ctrl = new ForgotPasswordController();

            ctrl.init();

        });

    </script>

}