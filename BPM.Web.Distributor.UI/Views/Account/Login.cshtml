@{
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
    ViewData["Title"] = "Login";
}

<style>
    /* Enhanced Login Form Styles */
    .login-wrapper {
        padding: 0 20px;
        position: relative;
    }

    /* Modern Pharmacy Logo Styles */
    .pharmacy-logo {
        display: inline-flex;
        align-items: center;
        gap: 16px;
        text-decoration: none;
        position: relative;
    }

        .pharmacy-logo .logo-icon {
            position: relative;
            width: 56px;
            height: 56px;
            flex-shrink: 0;
        }

            .pharmacy-logo .logo-icon svg {
                width: 100%;
                height: 100%;
                filter: drop-shadow(0 4px 12px rgba(13, 148, 136, 0.25));
            }

        .pharmacy-logo .logo-text {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            line-height: 1.2;
        }

            .pharmacy-logo .logo-text .brand-name {
                font-size: 28px;
                font-weight: 800;
                background: linear-gradient(135deg, #0d9488 0%, #0e7490 100%);
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
                background-clip: text;
                letter-spacing: -0.5px;
            }

            .pharmacy-logo .logo-text .brand-tagline {
                font-size: 10px;
                font-weight: 600;
                color: #64748b;
                text-transform: uppercase;
                letter-spacing: 2.5px;
                -webkit-text-fill-color: #64748b;
                margin-top: -2px;
            }

    /* Animated title underline */
    .animated-title {
        position: relative;
        display: inline-block;
    }

        .animated-title::after {
            content: '';
            position: absolute;
            bottom: -5px;
            left: 0;
            width: 0;
            height: 3px;
            background: linear-gradient(90deg, #0d9488, #0e7490);
            animation: expandUnderline 3s ease-in-out infinite;
        }

    @@keyframes expandUnderline {
        0% {
            width: 0;
            left: 0;
        }

        50% {
            width: 100%;
            left: 0;
        }

        100% {
            width: 0;
            left: 100%;
        }
    }

    /* Enhanced form inputs with icon */
    .input-group-enhanced {
        position: relative;
        transition: all 0.3s ease;
    }

        .input-group-enhanced .input-icon {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #a0aec0;
            font-size: 20px;
            z-index: 10;
            transition: all 0.3s ease;
            pointer-events: none;
        }

        .input-group-enhanced .form-control {
            padding-left: 48px;
            padding-right: 48px;
            height: 56px;
            border-radius: 14px;
            border: 2px solid #e2e8f0;
            transition: all 0.3s ease;
            background: #f8fafc;
            font-size: 15px;
        }

            .input-group-enhanced .form-control:focus {
                border-color: #0d9488;
                background: white;
                box-shadow: 0 0 0 4px rgba(13, 148, 136, 0.12);
                transform: translateY(-2px);
            }

                .input-group-enhanced .form-control:focus ~ .input-icon {
                    color: #0d9488;
                }

        .input-group-enhanced .password-toggle {
            position: absolute;
            right: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #a0aec0;
            font-size: 20px;
            cursor: pointer;
            z-index: 10;
            transition: all 0.3s ease;
        }

            .input-group-enhanced .password-toggle:hover {
                color: #0d9488;
            }

    /* Floating labels animation */
    .form-floating-enhanced {
        position: relative;
    }

        .form-floating-enhanced .form-control {
            height: 56px;
            border-radius: 14px;
            border: 2px solid #e2e8f0;
            padding-left: 48px;
            transition: all 0.3s ease;
            background: #f8fafc;
            font-size: 15px;
        }

            .form-floating-enhanced .form-control:focus {
                border-color: #0d9488;
                background: white;
                box-shadow: 0 0 0 4px rgba(13, 148, 136, 0.12);
                transform: translateY(-2px);
            }

        .form-floating-enhanced label {
            position: absolute;
            top: 50%;
            left: 48px;
            transform: translateY(-50%);
            color: #a0aec0;
            transition: all 0.3s ease;
            pointer-events: none;
            font-size: 15px;
            background: transparent;
            padding: 0 5px;
        }

        .form-floating-enhanced .form-control:focus ~ label,
        .form-floating-enhanced .form-control:not(:placeholder-shown) ~ label {
            top: -10px;
            left: 15px;
            font-size: 12px;
            color: #0d9488;
            background: white;
            padding: 0 8px;
            border-radius: 6px;
        }

    /* Modern checkbox */
    .modern-checkbox {
        display: flex;
        align-items: center;
        gap: 10px;
        cursor: pointer;
    }

        .modern-checkbox input[type="checkbox"] {
            display: none;
        }

        .modern-checkbox .checkmark {
            width: 22px;
            height: 22px;
            border: 2px solid #d1d5db;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s ease;
            flex-shrink: 0;
            background: #f8fafc;
        }

        .modern-checkbox input:checked ~ .checkmark {
            background: linear-gradient(135deg, #0d9488, #0e7490);
            border-color: #0d9488;
            animation: checkPop 0.3s ease;
        }

            .modern-checkbox input:checked ~ .checkmark::after {
                content: '✓';
                color: white;
                font-size: 14px;
                font-weight: bold;
            }

    @@keyframes checkPop {
        0% {
            transform: scale(1);
        }

        50% {
            transform: scale(1.2);
        }

        100% {
            transform: scale(1);
        }
    }

    /* Modern button with pulse effect */
    .btn-modern {
        position: relative;
        border: none;
        padding: 16px 30px;
        border-radius: 14px;
        font-weight: 600;
        font-size: 16px;
        color: white;
        background: linear-gradient(135deg, #0d9488, #0e7490);
        transition: all 0.3s ease;
        overflow: hidden;
        width: 100%;
    }

        .btn-modern::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
            transition: left 0.5s ease;
        }

        .btn-modern:hover::before {
            left: 100%;
        }

        .btn-modern:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 30px rgba(13, 148, 136, 0.35);
            background: linear-gradient(135deg, #0f766e, #0d9488);
        }

        .btn-modern:active {
            transform: translateY(0px);
        }

    /* Social buttons with hover effects */
    .social-btn {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 18px;
        transition: all 0.3s ease;
        text-decoration: none;
        border: none;
    }

        .social-btn:hover {
            transform: translateY(-4px) scale(1.1);
            box-shadow: 0 8px 25px rgba(0,0,0,0.15);
        }

        .social-btn.facebook {
            background: #3a559f;
        }

        .social-btn.twitter {
            background: #0f1419;
        }

        .social-btn.google {
            background: #e02f2f;
        }

        .social-btn.linkedin {
            background: #007ab9;
        }

    /* Divider with animated line */
    .divider {
        display: flex;
        align-items: center;
        gap: 15px;
        margin: 20px 0;
    }

        .divider .line {
            flex: 1;
            height: 2px;
            background: linear-gradient(90deg, transparent, #e2e8f0, transparent);
            position: relative;
        }

            .divider .line::after {
                content: '';
                position: absolute;
                top: 0;
                left: -100%;
                width: 100%;
                height: 100%;
                background: linear-gradient(90deg, transparent, #0d9488, transparent);
                animation: slideLine 3s ease-in-out infinite;
            }

    @@keyframes slideLine {
        0% {
            left: -100%;
        }

        50% {
            left: 100%;
        }

        100% {
            left: 100%;
        }
    }

    .divider .text {
        color: #a0aec0;
        font-size: 14px;
        font-weight: 500;
        white-space: nowrap;
        padding: 0 5px;
        background: white;
    }

    /* Forgot password link */
    .forgot-link {
        color: #0d9488;
        text-decoration: none;
        font-weight: 500;
        transition: all 0.3s ease;
        position: relative;
    }

        .forgot-link::after {
            content: '';
            position: absolute;
            bottom: -2px;
            left: 0;
            width: 0;
            height: 2px;
            background: #0d9488;
            transition: width 0.3s ease;
        }

        .forgot-link:hover::after {
            width: 100%;
        }

        .forgot-link:hover {
            color: #0f766e;
        }

    /* Responsive adjustments */
    @@media (max-width: 576px) {
        .login-wrapper {
            padding: 0 10px;
        }

        .pharmacy-logo .logo-icon {
            width: 44px;
            height: 44px;
        }

        .pharmacy-logo .logo-text .brand-name {
            font-size: 22px;
        }

        .pharmacy-logo .logo-text .brand-tagline {
            font-size: 8px;
        }

        .input-group-enhanced .form-control {
            height: 50px;
            font-size: 14px;
        }

        .btn-modern {
            padding: 14px 20px;
            font-size: 14px;
        }
    }
</style>

<div class="login-wrapper" style="max-width: 100%; padding: 0 30px;">
    <!-- Modern Pharmacy Logo -->
    <div class="text-center mb-4">
        <a class="pharmacy-logo" href="/">
            <div class="logo-icon">
                <svg viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <!-- Background circle with gradient -->
                    <circle cx="50" cy="50" r="48" fill="url(#logoGradient)" stroke="#0d9488" stroke-width="2" />

                    <!-- Medical Cross -->
                    <rect x="40" y="20" width="20" height="60" rx="3" fill="white" opacity="0.95" />
                    <rect x="20" y="40" width="60" height="20" rx="3" fill="white" opacity="0.95" />

                    <!-- Leaf symbol -->
                    <path d="M70 30 C78 25, 85 30, 82 40 C79 50, 72 48, 70 45 C68 42, 65 38, 70 30Z"
                          fill="white" opacity="0.8" transform="rotate(15, 75, 35)" />
                    <path d="M30 70 C22 75, 15 70, 18 60 C21 50, 28 52, 30 55 C32 58, 35 62, 30 70Z"
                          fill="white" opacity="0.8" transform="rotate(-15, 25, 65)" />

                    <!-- BPM Letters integrated -->
                    <text x="50" y="48" text-anchor="middle" font-size="22" font-weight="800"
                          font-family="Arial, sans-serif" fill="#0d9488" letter-spacing="2">
                        B
                    </text>
                    <text x="50" y="68" text-anchor="middle" font-size="16" font-weight="700"
                          font-family="Arial, sans-serif" fill="#0e7490" letter-spacing="1">
                        PM
                    </text>

                    <!-- Small decorative dots -->
                    <circle cx="25" cy="25" r="3" fill="white" opacity="0.3" />
                    <circle cx="75" cy="25" r="3" fill="white" opacity="0.3" />
                    <circle cx="25" cy="75" r="3" fill="white" opacity="0.3" />
                    <circle cx="75" cy="75" r="3" fill="white" opacity="0.3" />

                    <!-- Gradient definitions -->
                    <defs>
                        <linearGradient id="logoGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                            <stop offset="0%" style="stop-color:#0d9488;stop-opacity:0.15" />
                            <stop offset="100%" style="stop-color:#0e7490;stop-opacity:0.08" />
                        </linearGradient>
                    </defs>
                </svg>
            </div>
            <div class="logo-text">
                <span class="brand-name">BPM Medicals</span>
                <span class="brand-tagline">Healthcare Solutions</span>
            </div>
        </a>
    </div>

    <!-- Alert Container for Errors -->
    <div id="alert-container"></div>

    <!-- Sign In Form -->
    <div id="signin-form">
        <div class="text-center mb-4">
            <h3 class="fs-26 fw-medium animated-title" style="margin-bottom: 6px;">
                Welcome Back!
            </h3>
            <p class="fs-16 text-secondary lh-1-8" style="color: #64748b;">
                Sign in to your account
            </p>
        </div>

        <form id="loginForm" action="/Account/Login" method="post">
            <div class="mb-20">
                <div class="input-group-enhanced form-floating-enhanced">
                    <input id="loginEmail" name="Email" class="form-control" placeholder=" " type="email" />
                    <i class="ri-mail-line input-icon"></i>
                    <label for="loginEmail">Email Address</label>
                    <span id="loginEmailError" class="text-danger" style="display: none; font-size: 13px; margin-top: 5px;"></span>
                </div>
            </div>

            <div class="mb-20">
                <div class="input-group-enhanced form-floating-enhanced">
                    <input id="loginPassword" name="Password" class="form-control password" placeholder=" " type="password" />
                    <i class="ri-lock-line input-icon"></i>
                    <label for="loginPassword">Your Password</label>
                    <i aria-hidden="true" class="ri-eye-off-line password-toggle" onclick="togglePasswordVisibility(this)"></i>
                    <span id="loginPasswordError" class="text-danger" style="display: none; font-size: 13px; margin-top: 5px;"></span>
                </div>
            </div>

            <div class="mb-20">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-1">
                    <label class="modern-checkbox">
                        <input id="rememberMe" name="RememberMe" type="checkbox" value="true" />
                        <span class="checkmark"></span>
                        <span style="font-size: 14px; color: #475569;">Remember me</span>
                    </label>
                    <a class="forgot-link" href="javascript:void(0);" onclick="showForm('forgot')">
                        Forgot Password?
                    </a>
                </div>
            </div>

            <div class="mb-4">
                <button class="btn-modern" type="submit">
                    <i class="ri-login-circle-line me-2"></i> Sign In
                </button>
            </div>

            <div class="divider">
                <span class="line"></span>
                <span class="text">or continue with</span>
                <span class="line"></span>
            </div>

            <ul class="p-0 mb-0 list-unstyled d-flex justify-content-center" style="gap: 12px;">
                <li>
                    <a class="social-btn facebook" href="https://www.facebook.com/" target="_blank">
                        <i class="ri-facebook-fill"></i>
                    </a>
                </li>
                <li>
                    <a class="social-btn twitter" href="https://www.twitter.com/" target="_blank">
                        <i class="ri-twitter-x-line"></i>
                    </a>
                </li>
                <li>
                    <a class="social-btn google" href="https://www.google.com/" target="_blank">
                        <i class="ri-google-fill"></i>
                    </a>
                </li>
                <li>
                    <a class="social-btn linkedin" href="https://www.linkedin.com/" target="_blank">
                        <i class="ri-linkedin-fill"></i>
                    </a>
                </li>
            </ul>
        </form>
    </div>

    <!-- Forgot Password Form (Hidden) -->
    <div id="forgot-form" style="display: none;">
        <div class="text-center mb-4">
            <h3 class="fs-26 fw-medium animated-title" style="margin-bottom: 6px;">
                Forgot Password
            </h3>
            <p class="fs-16 text-secondary lh-1-8" style="color: #64748b;">
                Enter your email to reset password
            </p>
        </div>

        <form id="forgotPasswordForm" action="/Account/ForgotPassword" method="post">
            <div class="mb-20">
                <div class="input-group-enhanced form-floating-enhanced">
                    <input id="forgotEmail" name="Email" class="form-control" placeholder=" " type="email" />
                    <i class="ri-mail-line input-icon"></i>
                    <label for="forgotEmail">Email Address</label>
                    <span id="forgotEmailError" class="text-danger" style="display: none; font-size: 13px; margin-top: 5px;"></span>
                </div>
            </div>

            <div class="mb-4">
                <button class="btn-modern" type="submit">
                    <i class="ri-send-plane-line me-2"></i> Send Reset Link
                </button>
            </div>

            <div class="text-center">
                <a class="forgot-link" href="javascript:void(0);" onclick="showForm('signin')">
                    <i class="ri-arrow-left-line"></i> Back to Sign In
                </a>
            </div>
        </form>
    </div>
</div>

<script>
    function showForm(formType) {
        document.getElementById('signin-form').style.display = 'none';
        document.getElementById('signup-form').style.display = 'none';
        document.getElementById('forgot-form').style.display = 'none';

        if (formType === 'signin') {
            document.getElementById('signin-form').style.display = 'block';
        } else if (formType === 'signup') {
            document.getElementById('signup-form').style.display = 'block';
        } else if (formType === 'forgot') {
            document.getElementById('forgot-form').style.display = 'block';
        }
    }

    function togglePasswordVisibility(element) {
        const input = element.closest('.input-group-enhanced').querySelector('.password');
        if (input.type === 'password') {
            input.type = 'text';
            element.className = 'ri-eye-line password-toggle';
        } else {
            input.type = 'password';
            element.className = 'ri-eye-off-line password-toggle';
        }
    }
</script>