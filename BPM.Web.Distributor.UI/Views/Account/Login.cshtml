@model LoginViewModel

@{
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
    ViewData["Title"] = "Login";
}

<div class="login-wrapper">

    <div class="auth-container">

        <!-- LEFT PANEL -->

        <div class="auth-image-section">

            <img src="~/assets/images/png/drug_landing.jpg"
                 class="auth-image"
                 alt="Drug Landing" />

            <div class="image-overlay">

                <div class="image-content">

                    <div class="brand-large">

                        <div class="brand-icon-large">
                            <i class="bi bi-hexagon-fill"></i>
                            <i class="bi bi-grid-1x2-fill"></i>
                        </div>

                        <h1 class="brand-name">
                            BPM<span>Medicals</span>
                        </h1>

                        <p class="brand-tagline">
                            Enterprise Medical Dealer Platform
                        </p>

                    </div>

                    <div class="image-features">

                        <div class="feature-item">

                            <div class="feature-icon">
                                <i class="bi bi-shield-check"></i>
                            </div>

                            <div class="feature-text">

                                <h4>Secure Access</h4>

                                <p>
                                    Enterprise-grade security with end-to-end encryption
                                </p>

                            </div>

                        </div>

                        <div class="feature-item">

                            <div class="feature-icon">
                                <i class="bi bi-graph-up-arrow"></i>
                            </div>

                            <div class="feature-text">

                                <h4>Real-time Analytics</h4>

                                <p>
                                    Monitor your business performance in real time
                                </p>

                            </div>

                        </div>

                        <div class="feature-item">

                            <div class="feature-icon">
                                <i class="bi bi-people"></i>
                            </div>

                            <div class="feature-text">

                                <h4>Team Collaboration</h4>

                                <p>
                                    Work seamlessly with your team
                                </p>

                            </div>

                        </div>

                    </div>

                    <div class="testimonial">

                        <div class="testimonial-quote">

                            <i class="bi bi-quote"></i>

                            <p>
                                "The best admin dashboard solution for modern businesses"
                            </p>

                        </div>

                        <div class="testimonial-author">

                            <img src="~/assets/images/png/user.png"
                                 class="author-avatar" />
                            <div>

                                <strong>John Doe</strong>

                                <span>CEO, TechCorp</span>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <!-- RIGHT PANEL -->

        <div class="auth-form-section">

            <div class="auth-card">

                <div class="form-header">

                    <div class="welcome-badge">

                        <i class="bi bi-arrow-right-circle"></i>

                        <span>Sign in to continue</span>

                    </div>

                    <h1>Welcome Back</h1>

                    <p>
                        Sign in to manage your workspace and access all features.
                    </p>

                </div>

                <form id="loginForm"
                      asp-action="Login"
                      asp-controller="Account"
                      method="post">

                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3"></div>

                    <!-- Username -->

                    <div class="form-group">

                        <label asp-for="Username"
                               class="form-label"></label>

                        <div class="input-group">

                            <span class="input-group-text">

                                <i class="bi bi-envelope"></i>

                            </span>

                            <input asp-for="Username"
                                   class="form-control"
                                   placeholder="Enter your email or username" />

                        </div>

                        <span asp-validation-for="Username"
                              class="text-danger"></span>

                    </div>

                    <!-- Password -->

                    <div class="form-group">

                        <div class="d-flex justify-content-between">

                            <label asp-for="Password"
                                   class="form-label"></label>

                            <a asp-action="ForgotPassword"
                               class="forgot-link">

                                Forgot Password?

                            </a>

                        </div>

                        <div class="input-group">

                            <span class="input-group-text">

                                <i class="bi bi-lock"></i>

                            </span>

                            <input asp-for="Password"
                                   id="password"
                                   type="password"
                                   class="form-control"
                                   placeholder="Enter password" />

                            <button type="button"
                                    class="password-toggle"
                                    onclick="togglePassword()">

                                <i id="eyeIcon"
                                   class="bi bi-eye"></i>

                            </button>

                        </div>

                        <span asp-validation-for="Password"
                              class="text-danger"></span>

                    </div>

                    <div class="form-options">

                        <div class="form-check">

                            <input asp-for="RememberMe"
                                   class="form-check-input" />

                            <label asp-for="RememberMe"
                                   class="form-check-label"></label>

                        </div>

                        <a href="#">
                            Privacy Policy
                        </a>

                    </div>

                    <button id="btnLogin"
                            type="submit"
                            class="btn btn-primary w-100">

                        Sign In

                        <i class="bi bi-arrow-right-circle ms-2"></i>

                    </button>

                </form>

                <div class="divider">

                    <span>or continue with</span>

                </div>

                <div class="social-login">

                    <button class="social-btn">

                        <i class="bi bi-google"></i>

                        Google

                    </button>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    <script src="~/assets/js/Application/LoginController.js"></script>

    <script>

        $(function () {

            var ctrl = new LoginController();

            ctrl.init();

        });

    </script>

}