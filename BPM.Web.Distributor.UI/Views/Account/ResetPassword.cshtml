@model ResetPasswordViewModel

@{
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
    ViewData["Title"] = "Reset Password";
}

<div class="login-wrapper">

    <div class="auth-container">

        <!-- LEFT PANEL -->

        <div class="auth-image-section">

            <img src="~/assets/images/png/drug_landing.jpg"
                 class="auth-image"
                 alt="Drug Landing" />

            <div class="image-overlay">

                <div class="image-content">

                    <div class="brand-large">

                        <div class="brand-icon-large">

                            <i class="bi bi-hexagon-fill"></i>
                            <i class="bi bi-grid-1x2-fill"></i>

                        </div>

                        <h1 class="brand-name">

                            BPM<span>Medicals</span>

                        </h1>

                        <p class="brand-tagline">

                            Enterprise Medical Dealer Platform

                        </p>

                    </div>

                    <div class="image-features">

                        <div class="feature-item">

                            <div class="feature-icon">

                                <i class="bi bi-shield-check"></i>

                            </div>

                            <div class="feature-text">

                                <h4>Secure Access</h4>

                                <p>
                                    Enterprise-grade security with end-to-end encryption.
                                </p>

                            </div>

                        </div>

                        <div class="feature-item">

                            <div class="feature-icon">

                                <i class="bi bi-key"></i>

                            </div>

                            <div class="feature-text">

                                <h4>Password Recovery</h4>

                                <p>
                                    Securely reset your password in just a few steps.
                                </p>

                            </div>

                        </div>

                        <div class="feature-item">

                            <div class="feature-icon">

                                <i class="bi bi-clock-history"></i>

                            </div>

                            <div class="feature-text">

                                <h4>Quick Recovery</h4>

                                <p>
                                    Get back to work with our fast password reset process.
                                </p>

                            </div>

                        </div>

                    </div>

                    <div class="testimonial">

                        <div class="testimonial-quote">

                            <i class="bi bi-quote"></i>

                            <p>

                                "Quick and secure password recovery process"

                            </p>

                        </div>

                        <div class="testimonial-author">

                            <img src="https://via.placeholder.com/40"
                                 class="author-avatar" />

                            <div>

                                <strong>Sarah Johnson</strong>

                                <span>IT Director, InnovateCorp</span>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <!-- RIGHT PANEL -->

        <div class="auth-form-section">

            <div class="auth-card">

                <div class="form-header">

                    <div class="welcome-badge">

                        <i class="bi bi-key-fill"></i>

                        <span>Create New Password</span>

                    </div>

                    <h1>

                        Reset Password

                    </h1>

                    <p>

                        Please enter your new password below.

                    </p>

                </div>

                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger">

                        <i class="bi bi-exclamation-triangle-fill me-2"></i>

                        @TempData["Error"]

                    </div>
                }

                <form id="resetPasswordForm"
                      asp-action="ResetPassword"
                      asp-controller="Account"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input asp-for="UserId" type="hidden"/>

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3"></div>

                    <!-- Password Requirements -->

                    <div class="password-requirements mb-4">

                        <small class="text-muted d-block mb-2">

                            Password Requirements

                        </small>

                        <div id="reqLength" class="requirement-item">

                            <i class="fas fa-circle"></i>

                            At least 6 characters

                        </div>

                        <div id="reqUpper" class="requirement-item">

                            <i class="fas fa-circle"></i>

                            At least one uppercase letter

                        </div>

                        <div id="reqLower" class="requirement-item">

                            <i class="fas fa-circle"></i>

                            At least one lowercase letter

                        </div>

                        <div id="reqNumber" class="requirement-item">

                            <i class="fas fa-circle"></i>

                            At least one number

                        </div>

                    </div>

                    <!-- New Password -->

                    <div class="form-group">

                        <label asp-for="NewPassword"
                               class="form-label">

                        </label>

                        <div class="input-group">

                            <span class="input-group-text">

                                <i class="bi bi-lock"></i>

                            </span>

                            <input asp-for="NewPassword"
                                   id="newPassword"
                                   type="password"
                                   class="form-control"
                                   placeholder="Enter new password"/>

                            <button type="button"
                                    class="password-toggle"
                                    onclick="toggleNewPassword()">

                                <i id="newEye"
                                   class="bi bi-eye"></i>

                            </button>

                        </div>

                        <span asp-validation-for="NewPassword"
                              class="text-danger"></span>

                    </div>

                    <!-- Confirm Password -->

                    <div class="form-group">

                        <label asp-for="ConfirmPassword"
                               class="form-label">

                        </label>

                        <div class="input-group">

                            <span class="input-group-text">

                                <i class="bi bi-lock-fill"></i>

                            </span>

                            <input asp-for="ConfirmPassword"
                                   id="confirmPassword"
                                   type="password"
                                   class="form-control"
                                   placeholder="Confirm password"/>

                            <button type="button"
                                    class="password-toggle"
                                    onclick="toggleConfirmPassword()">

                                <i id="confirmEye"
                                   class="bi bi-eye"></i>

                            </button>

                        </div>

                        <span asp-validation-for="ConfirmPassword"
                              class="text-danger"></span>

                    </div>
                    <!-- Confirmation Checkbox -->

                    <div class="form-check mt-3 mb-3">

                        <input asp-for="ConfirmReset"
                               class="form-check-input"
                               id="ConfirmReset" />

                        <label asp-for="ConfirmReset"
                               class="form-check-label">

                            I confirm that I want to reset my password.

                        </label>

                    </div>

                    <span asp-validation-for="ConfirmReset"
                          class="text-danger"></span>

                    <button id="btnReset"
                            type="submit"
                            class="btn btn-primary w-100 mt-4">

                        Update Password

                        <i class="bi bi-key ms-2"></i>

                    </button>

                </form>

                <div class="divider">

                    <span>

                        Remember your password?

                    </span>

                </div>

                <div class="auth-footer">

                    <p>

                        <a asp-action="Login"
                           asp-controller="Account"
                           class="text-decoration-none">

                            <i class="bi bi-arrow-left"></i>

                            Back to Login

                        </a>

                    </p>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    <script src="~/assets/js/Application/ResetPasswordController.js"></script>

    <script>

        $(function () {

            var ctrl = new ResetPasswordController();

            ctrl.init();

        });

    </script>

}