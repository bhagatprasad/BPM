@using BPM.Web.Distributor.UI.Models.ViewModels
@model ResetPasswordViewModel

@{
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
    ViewData["Title"] = "Reset Password";
}

<div class="login-wrapper">

    <div class="auth-container">

        <!-- LEFT PANEL -->
        @await Html.PartialAsync("_AuthLeftPanel")

        <!-- RIGHT PANEL -->

        <div class="auth-form-section">

            <div class="auth-card">

                <div class="form-header">

                    <div class="welcome-badge">

                        <i class="bi bi-shield-lock"></i>

                        <span>Create a new password</span>

                    </div>

                    <h1>Reset Password</h1>

                    <p>
                        Create a strong password to secure your account.
                    </p>

                </div>

                <form id="formResetPassword">

                    @Html.AntiForgeryToken()

                    <input asp-for="UserId" id="userId" type="hidden" />

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>

                    <!-- New Password -->

                    <div class="form-group">

                        <label asp-for="NewPassword"
                               class="form-label">
                        </label>

                        <div class="input-group">

                            <span class="input-group-text">
                                <i class="bi bi-lock"></i>
                            </span>

                            <input asp-for="NewPassword"
                                   id="password"
                                   type="password"
                                   class="form-control"
                                   placeholder="Enter new password" />

                            <button type="button"
                                    class="password-toggle"
                                    onclick="togglePassword('password','eye1')">

                                <i id="eye1"
                                   class="bi bi-eye"></i>

                            </button>

                        </div>

                        <span asp-validation-for="NewPassword"
                              class="text-danger"></span>

                    </div>

                    <!-- Confirm Password -->

                    <div class="form-group">

                        <label asp-for="ConfirmPassword"
                               class="form-label">
                        </label>

                        <div class="input-group">

                            <span class="input-group-text">
                                <i class="bi bi-lock-fill"></i>
                            </span>

                            <input asp-for="ConfirmPassword"
                                   id="confirmPassword"
                                   type="password"
                                   class="form-control"
                                   placeholder="Confirm password" />

                            <button type="button"
                                    class="password-toggle"
                                    onclick="togglePassword('confirmPassword','eye2')">

                                <i id="eye2"
                                   class="bi bi-eye"></i>

                            </button>

                        </div>

                        <span asp-validation-for="ConfirmPassword"
                              class="text-danger"></span>

                    </div>

                    <button id="btnSubmit"
                            type="button"
                            class="btn btn-primary w-100">

                        Reset Password

                        <i class="bi bi-arrow-right-circle ms-2"></i>

                    </button>

                </form>

                <div class="divider">

                    <span>Password remembered?</span>

                </div>

                <div class="text-center">

                    <a asp-action="Login"
                       asp-controller="Account"
                       class="forgot-link">

                        <i class="bi bi-arrow-left"></i>

                        Back to Login

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        function togglePassword(id, eyeId) {

            var txt = document.getElementById(id);
            var eye = document.getElementById(eyeId);

            if (txt.type === "password") {

                txt.type = "text";

                eye.classList.remove("bi-eye");
                eye.classList.add("bi-eye-slash");

            }
            else {

                txt.type = "password";

                eye.classList.remove("bi-eye-slash");
                eye.classList.add("bi-eye");

            }

        }

    </script>

    <script src="~/assets/js/Application/ResetPasswordController.js"></script>

    <script>

        $(function () {

            var controller = new ResetPasswordController();

            controller.init();

        });

    </script>

}