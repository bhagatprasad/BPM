@{
    ViewData["Title"] = "Dealer Purchase Orders";
}

<div class="main-content-container overflow-hidden">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4 mt-1">

        <h3 class="mb-0">Dealer Purchase Orders</h3>

        <nav aria-label="breadcrumb">
            <ol class="breadcrumb align-items-center mb-0 lh-1">

                <li class="breadcrumb-item">
                    <a asp-controller="Dashboard" asp-action="Index"
                       class="d-flex align-items-center text-decoration-none">
                        <i class="ri-home-8-line fs-15 text-primary me-1"></i>
                        <span class="text-body fs-14">Dashboard</span>
                    </a>
                </li>

                <li class="breadcrumb-item">
                    Inventory
                </li>

                <li class="breadcrumb-item active text-secondary">
                    Dealers
                </li>

            </ol>
        </nav>

    </div>

    <!-- Card -->
    <div class="card bg-white rounded-10 border border-white mb-4">

        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 p-20">

            <input type="text"
                   id="txtSearch"
                   class="form-control w-350"
                   placeholder="Search dealer..." />

        </div>

        <div class="table-responsive">

            <table id="tblDealers" class="table table-bordered">

                <thead>

                    <tr>

                        <th></th>
                        <th>Dealer Name</th>
                        <th>Contact Person</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>City</th>
                        <th>Status</th>

                    </tr>

                </thead>

                <tbody>
                </tbody>

            </table>

        </div>

        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 p-20">

            <span id="lblEntries">
                Showing 0 to 0 of 0 entries
            </span>

            <nav>

                <ul class="pagination mb-0"
                    id="pagination">
                </ul>

            </nav>

        </div>

    </div>

</div>

@section Scripts
{
   
    <script src="~/js/DealerPurchaseOrderController.js"></script>

    <script>

        $(document).ready(function () {

            var controller = new DealerPurchaseOrderController();

            controller.init();

        });

    </script>
}