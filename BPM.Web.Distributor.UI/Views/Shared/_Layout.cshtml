<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1, shrink-to-fit=no" name="viewport" />
    <title>@ViewData["Title"] - BPM Distributor</title>
    <!-- Links Of CSS File -->
    <link href="~/assets/css/sidebar-menu.css" rel="stylesheet" />
    <link href="~/assets/css/simplebar.css" rel="stylesheet" />
    <link href="~/assets/css/prism.css" rel="stylesheet" />
    <link href="~/assets/css/quill.snow.css" rel="stylesheet" />
    <link href="~/assets/css/remixicon.css" rel="stylesheet" />
    <link href="~/assets/css/swiper-bundle.min.css" rel="stylesheet" />
    <link href="~/assets/css/jsvectormap.min.css" rel="stylesheet" />
    <link href="~/assets/css/style.css" rel="stylesheet" />
    <link href="~/assets/css/layoutstyle.css" rel="stylesheet" />
    <link href="~/assets/css/loader.css" rel="stylesheet" />
    <!-- Favicon -->
    <link href="~/assets/images/favicon.png" rel="icon" type="image/png" />

   
</head>
<body class="bg-body-bg">
    <partial name="_loaderPartial" />
    <!-- Layout Container -->
    <div class="layout-wrapper layout-content-navbar">
        <div class="layout-container">
            <!-- Sidebar -->
            <partial name="_sideBarNavigationPartial" />

            <!-- Main Content Area -->
            <div class="layout-page">
                <div class="content-wrapper">
                    <div class="container-fluid">
                        <div class="main-content d-flex flex-column">
                            <partial name="_topBarNavigationPartial" />
                            @RenderBody()
                            <div class="flex-grow-1">
                            </div>
                            <partial name="_footerPartial" />
                            <!-- End Footer Area -->
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- All Required JavaScript Libraries -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/assets/js/bootstrap.bundle.min.js"></script>
    <script src="~/assets/js/simplebar.min.js"></script>
    <script src="~/assets/js/sidebar-menu.js"></script>
    <script src="~/assets/js/quill.min.js"></script>
    <script src="~/assets/js/data-table.js"></script>
    <script src="~/assets/js/prism.js"></script>
    <script src="~/assets/js/clipboard.min.js"></script>
    <script src="~/assets/js/apexcharts.min.js"></script>
    <script src="~/assets/js/echarts.min.js"></script>
    <script src="~/assets/js/swiper-bundle.min.js"></script>
    <script src="~/assets/js/fullcalendar.main.js"></script>
    <script src="~/assets/js/jsvectormap.min.js"></script>
    <script src="~/assets/js/world-merc.js"></script>
    <script src="~/assets/js/custom/apexcharts.js"></script>
    <script src="~/assets/js/custom/echarts.js"></script>
    <script src="~/assets/js/custom/maps.js"></script>
    <script src="~/assets/js/custom/custom.js"></script>
    <script src="~/js/CommonController.js"></script>
    <script src="~/js/StorageService.js"></script>

    <script>
            $(document).ready(function() {
                console.log('Layout loaded successfully');

                // Ensure sidebar menu works
                if (typeof $.fn.menu !== 'undefined') {
                    // If menu plugin exists, initialize it
                }

                // Global AJAX events for preloader
                $(window).on('load', function () {
                    $('#preloader').fadeOut(500);
                });

                $(document).ajaxStart(function () {
                    $('#preloader').fadeIn(300);
                });

                $(document).ajaxStop(function () {
                    $('#preloader').fadeOut(300);
                });

                $(document).ajaxError(function (event, jqxhr, settings, thrownError) {
                    $('#preloader').fadeOut(300);
                    if (jqxhr.status === 401) {
                        $('#loginEmailError').text('Session expired. Please login again.').show();
                        setTimeout(function () {
                            $('#loginEmailError').fadeOut(300);
                        }, 5000);
                    }
                });

                // Custom functions for manual control
                function showPharmacyLoader() {
                    $('#preloader').fadeIn(300);
                }

                function hidePharmacyLoader() {
                    $('#preloader').fadeOut(300);
                }

                function showPharmacyLoaderWithMessage(message) {
                    if (message) {
                        $('.loading-message').text(message);
                    }
                    showPharmacyLoader();
                }
            });
    </script>
     @await Component.InvokeAsync("Notyf")
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>