<script>
    function updateDateTime() {
        const now = new Date();
        const hour = now.getHours();

        let greeting = "Welcome";

        if (hour < 12) {
            greeting = "Welcome | Good Morning";
        } else if (hour < 17) {
            greeting = "Welcome | Good Afternoon";
        } else if (hour < 21) {
            greeting = "Welcome | Good Evening";
        } else {
            greeting = "Welcome | Good Night";
        }

        document.getElementById("greeting").innerText = greeting;

        const options = {
            weekday: 'long',
            year: 'numeric',
            month: 'long',
            day: 'numeric',
            hour: '2-digit',
            minute: '2-digit',
            second: '2-digit'
        };

        document.getElementById("currentDateTime").innerText =
            now.toLocaleString('en-IN', options);
    }

    updateDateTime();
    setInterval(updateDateTime, 1000);
</script>
