    <div class="logo position-relative d-flex align-items-center justify-content-between">
        <a class="d-block text-decoration-none position-relative" href="/">
            <!-- BPM Medicals Logo SVG -->
            <svg width="38" height="38" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg" style="display: inline-block; vertical-align: middle;">
                <!-- Background circle with gradient -->
                <circle cx="50" cy="50" r="48" fill="url(#sidebarLogoGradient)" stroke="#0d9488" stroke-width="2" />

                <!-- Medical Cross -->
                <rect x="40" y="20" width="20" height="60" rx="3" fill="white" opacity="0.95" />
                <rect x="20" y="40" width="60" height="20" rx="3" fill="white" opacity="0.95" />

