                <text x="50" y="68" text-anchor="middle" font-size="16" font-weight="700"
                      font-family="Arial, sans-serif" fill="#0e7490" letter-spacing="1">
                    PM
                </text>

                <!-- Small decorative dots -->
                <circle cx="25" cy="25" r="3" fill="white" opacity="0.3" />
                <circle cx="75" cy="25" r="3" fill="white" opacity="0.3" />
                <circle cx="25" cy="75" r="3" fill="white" opacity="0.3" />
