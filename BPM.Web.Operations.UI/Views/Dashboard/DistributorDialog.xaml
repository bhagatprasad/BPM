<!-- Views/Dashboard/DistributorDialog.xaml -->
<Window x:Class="BPM.Web.Operations.UI.Views.Dashboard.DistributorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Title="Distributor"
        Height="750" 
        Width="650"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#f8fafc">

    <Window.Resources>
        <Style x:Key="BpmDialogTextBox" TargetType="TextBox" BasedOn="{StaticResource BpmTextBox}">
            <Setter Property="Height" Value="38" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style x:Key="BpmDialogComboBox" TargetType="ComboBox" BasedOn="{StaticResource BpmComboBox}">
            <Setter Property="Height" Value="38" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style x:Key="BpmDialogButton" TargetType="Button" BasedOn="{StaticResource BpmPrimaryButton}">
            <Setter Property="Height" Value="40" />
            <Setter Property="Width" Value="100" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style x:Key="BpmDialogSecondaryButton" TargetType="Button" BasedOn="{StaticResource BpmSecondaryButton}">
            <Setter Property="Height" Value="40" />
            <Setter Property="Width" Value="100" />
            <Setter Property="FontSize" Value="14" />
        </Style>
    </Window.Resources>

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock x:Name="TitleText" 
                       Text="Add Distributor" 
                       FontSize="22" 
                       FontWeight="SemiBold" 
                       Foreground="#1e293b"/>
            <TextBlock Text="Fill in the distributor information below" 
                       FontSize="13" 
                       Foreground="#64748b"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Form Fields -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Basic Information -->
                <Border Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,15"
                        Effect="{StaticResource CardShadow}">
                    <StackPanel>
                        <TextBlock Text="Basic Information" 
                                   FontSize="16" 
                                   FontWeight="SemiBold" 
                                   Foreground="#1e293b"
                                   Margin="0,0,0,15"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Distributor Code -->
                            <TextBlock Grid.Row="0" Grid.Column="0" 
                                       Text="Distributor Code *" 
                                       FontWeight="Medium" 
                                       Foreground="#475569"
                                       Margin="0,0,10,5"/>
                            <TextBox x:Name="DistributorCodeTextBox" 
                                     Grid.Row="1" Grid.Column="0" 
                                     Style="{StaticResource BpmDialogTextBox}"
                                     Margin="0,0,10,10"/>

                            <!-- Distributor Name -->
                            <TextBlock Grid.Row="0" Grid.Column="1" 
                                       Text="Distributor Name *" 
                                       FontWeight="Medium" 
                                       Foreground="#475569"
                                       Margin="0,0,0,5"/>
                            <TextBox x:Name="DistributorNameTextBox" 
                                     Grid.Row="1" Grid.Column="1" 
                                     Style="{StaticResource BpmDialogTextBox}"
                                     Margin="0,0,0,10"/>

                            <!-- Registration Number -->
                            <TextBlock Grid.Row="2" Grid.Column="0" 
                                       Text="Registration Number" 
                                       FontWeight="Medium" 
                                       Foreground="#475569"
                                       Margin="0,0,10,5"/>
                            <TextBox x:Name="RegistrationNumberTextBox" 
                                     Grid.Row="3" Grid.Column="0" 
                                     Style="{StaticResource BpmDialogTextBox}"
                                     Margin="0,0,10,10"/>

                            <!-- Drug License Number -->
                            <TextBlock Grid.Row="2" Grid.Column="1" 
                                       Text="Drug License Number" 
                                       FontWeight="Medium" 
                                       Foreground="#475569"
                                       Margin="0,0,0,5"/>
                            <TextBox x:Name="DrugLicenseNumberTextBox" 
                                     Grid.Row="3" Grid.Column="1" 
                                     Style="{StaticResource BpmDialogTextBox}"
                                     Margin="0,0,0,10"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Contact Information -->
                <Border Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,15"
                        Effect="{StaticResource CardShadow}">
                    <StackPanel>
                        <TextBlock Text="Contact Information" 
                                   FontSize="16" 
                                   FontWeight="SemiBold" 
                                   Foreground="#1e293b"
                                   Margin="0,0,0,15"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Contact Person -->
                            <TextBlock Grid.Row="0" Grid.Column="0" 
                                       Text="Contact Person *" 
                                       FontWeight="Medium" 
                                       Foreground="#475569"
                                       Margin="0,0,10,5"/>
                            <TextBox x:Name="ContactPersonTextBox" 
                                     Grid.Row="1" Grid.Column="0" 
                                     Style="{StaticResource BpmDialogTextBox}"
                                     Margin="0,0,10,10"/>

                            <!-- Email -->
                            <TextBlock Grid.Row="0" Grid.Column="1" 
                                       Text="Email *" 
                                       FontWeight="Medium" 
                                       Foreground="#475569"
                                       Margin="0,0,0,5"/>
                            <TextBox x:Name="EmailTextBox" 
                                     Grid.Row="1" Grid.Column="1" 
                                     Style="{StaticResource BpmDialogTextBox}"
                                     Margin="0,0,0,10"/>

                            <!-- Phone -->
                            <TextBlock Grid.Row="2" Grid.Column="0" 
                                       Text="Phone *" 
                                       FontWeight="Medium" 
                                       Foreground="#475569"
                                       Margin="0,0,10,5"/>
                            <TextBox x:Name="PhoneTextBox" 
                                     Grid.Row="3" Grid.Column="0" 
                                     Style="{StaticResource BpmDialogTextBox}"
                                     Margin="0,0,10,10"/>

                            <!-- Alternate Phone -->
                            <TextBlock Grid.Row="2" Grid.Column="1" 
                                       Text="Alternate Phone" 
                                       FontWeight="Medium" 
                                       Foreground="#475569"
                                       Margin="0,0,0,5"/>
                            <TextBox x:Name="AlternatePhoneTextBox" 
                                     Grid.Row="3" Grid.Column="1" 
                                     Style="{StaticResource BpmDialogTextBox}"
                                     Margin="0,0,0,10"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Address Information -->
                <Border Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,15"
                        Effect="{StaticResource CardShadow}">
                    <StackPanel>
                        <TextBlock Text="Address Information" 
                                   FontSize="16" 
                                   FontWeight="SemiBold" 
                                   Foreground="#1e293b"
                                   Margin="0,0,0,15"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Address Line 1 -->
                            <TextBlock Grid.Row="0" Grid.Column="0" 
                                       Text="Address Line 1" 
                                       FontWeight="Medium" 
                                       Foreground="#475569"
                                       Margin="0,0,10,5"/>
                            <TextBox x:Name="AddressLine1TextBox" 
                                     Grid.Row="1" Grid.Column="0" 
                                     Style="{StaticResource BpmDialogTextBox}"
                                     Margin="0,0,10,10"/>

                            <!-- Address Line 2 -->
                            <TextBlock Grid.Row="0" Grid.Column="1" 
                                       Text="Address Line 2" 
                                       FontWeight="Medium" 
                                       Foreground="#475569"
                                       Margin="0,0,0,5"/>
                            <TextBox x:Name="AddressLine2TextBox" 
                                     Grid.Row="1" Grid.Column="1" 
                                     Style="{StaticResource BpmDialogTextBox}"
                                     Margin="0,0,0,10"/>

                            <!-- City -->
                            <TextBlock Grid.Row="2" Grid.Column="0" 
                                       Text="City *" 
                                       FontWeight="Medium" 
                                       Foreground="#475569"
                                       Margin="0,0,10,5"/>
                            <TextBox x:Name="CityTextBox" 
                                     Grid.Row="3" Grid.Column="0" 
                                     Style="{StaticResource BpmDialogTextBox}"
                                     Margin="0,0,10,10"/>

                            <!-- State -->
                            <TextBlock Grid.Row="2" Grid.Column="1" 
                                       Text="State *" 
                                       FontWeight="Medium" 
                                       Foreground="#475569"
                                       Margin="0,0,0,5"/>
                            <TextBox x:Name="StateTextBox" 
                                     Grid.Row="3" Grid.Column="1" 
                                     Style="{StaticResource BpmDialogTextBox}"
                                     Margin="0,0,0,10"/>

                            <!-- Country -->
                            <TextBlock Grid.Row="4" Grid.Column="0" 
                                       Text="Country" 
                                       FontWeight="Medium" 
                                       Foreground="#475569"
                                       Margin="0,0,10,5"/>
                            <TextBox x:Name="CountryTextBox" 
                                     Grid.Row="5" Grid.Column="0" 
                                     Style="{StaticResource BpmDialogTextBox}"
                                     Margin="0,0,10,10"/>

                            <!-- Postal Code -->
                            <TextBlock Grid.Row="4" Grid.Column="1" 
                                       Text="Postal Code" 
                                       FontWeight="Medium" 
                                       Foreground="#475569"
                                       Margin="0,0,0,5"/>
                            <TextBox x:Name="PostalCodeTextBox" 
                                     Grid.Row="5" Grid.Column="1" 
                                     Style="{StaticResource BpmDialogTextBox}"
                                     Margin="0,0,0,10"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Additional Information -->
                <Border Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,15"
                        Effect="{StaticResource CardShadow}">
                    <StackPanel>
                        <TextBlock Text="Additional Information" 
                                   FontSize="16" 
                                   FontWeight="SemiBold" 
                                   Foreground="#1e293b"
                                   Margin="0,0,0,15"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- GST Number -->
                            <TextBlock Grid.Row="0" Grid.Column="0" 
                                       Text="GST Number" 
                                       FontWeight="Medium" 
                                       Foreground="#475569"
                                       Margin="0,0,10,5"/>
                            <TextBox x:Name="GSTNumberTextBox" 
                                     Grid.Row="1" Grid.Column="0" 
                                     Style="{StaticResource BpmDialogTextBox}"
                                     Margin="0,0,10,10"/>

                            <!-- Website -->
                            <TextBlock Grid.Row="0" Grid.Column="1" 
                                       Text="Website" 
                                       FontWeight="Medium" 
                                       Foreground="#475569"
                                       Margin="0,0,0,5"/>
                            <TextBox x:Name="WebsiteTextBox" 
                                     Grid.Row="1" Grid.Column="1" 
                                     Style="{StaticResource BpmDialogTextBox}"
                                     Margin="0,0,0,10"/>
                        </Grid>

                        <!-- Active Status -->
                        <CheckBox x:Name="IsActiveCheckBox" 
                                  Content="Active" 
                                  IsChecked="True"
                                  Style="{StaticResource BpmCheckBox}"
                                  Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <Border Grid.Row="2" 
                Background="White" 
                BorderBrush="#e2e8f0" 
                BorderThickness="0,1,0,0"
                Padding="0,15,0,0"
                Margin="0,20,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" 
                        Content="Cancel"
                        Style="{StaticResource BpmDialogSecondaryButton}"
                        Margin="0,0,10,0"
                        Click="CancelButton_Click"/>
                <Button x:Name="SaveButton" 
                        Content="Save"
                        Style="{StaticResource BpmDialogButton}"
                        Click="SaveButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>