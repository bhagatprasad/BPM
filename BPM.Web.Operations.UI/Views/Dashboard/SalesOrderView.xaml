<!-- Views/Dashboard/SalesOrderView.xaml -->
<UserControl x:Class="BPM.Web.Operations.UI.Views.Dashboard.SalesOrderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:converters="clr-namespace:BPM.Web.Operations.UI.Helper">

    <UserControl.Resources>

        <!-- ============================= -->
        <!-- Converters -->
        <!-- ============================= -->

        <converters:StatusToColorConverter x:Key="StatusToColorConverter" />
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />


        <!-- ============================= -->
        <!-- ComboBox Style -->
        <!-- ============================= -->

        <Style x:Key="BpmComboBox" TargetType="ComboBox">

            <Setter Property="Height" Value="38" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="BorderBrush" Value="#e2e8f0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Cursor" Value="Hand" />

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="ComboBox">

                        <Grid>

                            <Border x:Name="Border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <ContentPresenter Grid.Column="0"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                      Margin="{TemplateBinding Padding}"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left" />

                                    <ToggleButton Grid.Column="1"
                                                  Focusable="False"
                                                  IsChecked="{Binding IsDropDownOpen,
                                                        Mode=TwoWay,
                                                        RelativeSource={RelativeSource TemplatedParent}}"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Width="30"
                                                  Height="30"
                                                  Margin="0,0,5,0">

                                        <ToggleButton.Template>

                                            <ControlTemplate TargetType="ToggleButton">

                                                <Grid>

                                                    <Path x:Name="Arrow"
                                                          Fill="#64748b"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Data="M0,0 L4,5 L8,0 Z"
                                                          RenderTransformOrigin="0.5,0.5">

                                                        <Path.RenderTransform>
                                                            <RotateTransform Angle="0" />
                                                        </Path.RenderTransform>

                                                    </Path>

                                                </Grid>

                                                <ControlTemplate.Triggers>

                                                    <Trigger Property="IsChecked"
                                                             Value="True">

                                                        <Setter TargetName="Arrow"
                                                                Property="RenderTransform">

                                                            <Setter.Value>
                                                                <RotateTransform Angle="180" />
                                                            </Setter.Value>

                                                        </Setter>

                                                    </Trigger>

                                                </ControlTemplate.Triggers>

                                            </ControlTemplate>

                                        </ToggleButton.Template>

                                    </ToggleButton>

                                </Grid>

                            </Border>


                            <Popup x:Name="PART_Popup"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">

                                <Grid MaxHeight="{TemplateBinding MaxDropDownHeight}">

                                    <Border x:Name="DropDownBorder"
                                            Background="White"
                                            BorderBrush="#e2e8f0"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="4">

                                        <ScrollViewer x:Name="PART_ScrollViewer"
                                                      CanContentScroll="True">

                                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"
                                                             SnapsToDevicePixels="True" />

                                        </ScrollViewer>

                                    </Border>

                                </Grid>

                            </Popup>

                        </Grid>


                        <ControlTemplate.Triggers>

                            <Trigger Property="IsFocused"
                                     Value="True">

                                <Setter TargetName="Border"
                                        Property="BorderBrush"
                                        Value="{StaticResource PrimaryBrush}" />

                                <Setter TargetName="Border"
                                        Property="BorderThickness"
                                        Value="2" />

                            </Trigger>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="Border"
                                        Property="BorderBrush"
                                        Value="{StaticResource PrimaryBrush}" />

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter TargetName="Border"
                                        Property="Opacity"
                                        Value="0.6" />

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ============================= -->
        <!-- ComboBox Item -->
        <!-- ============================= -->

        <Style TargetType="ComboBoxItem">

            <Setter Property="Height" Value="35" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="ComboBoxItem">

                        <Border x:Name="Border"
                                Background="Transparent"
                                CornerRadius="6"
                                Margin="2">

                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />

                        </Border>


                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="#f1f5f9" />

                            </Trigger>

                            <Trigger Property="IsSelected"
                                     Value="True">

                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="#e0f2fe" />

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ============================= -->
        <!-- Child DataGrid -->
        <!-- ============================= -->

        <Style x:Key="ChildDataGrid"
               TargetType="DataGrid">

            <Setter Property="AutoGenerateColumns"
                    Value="False" />

            <Setter Property="CanUserSortColumns"
                    Value="True" />

            <Setter Property="HeadersVisibility"
                    Value="Column" />

            <Setter Property="RowHeaderWidth"
                    Value="0" />

            <Setter Property="Background"
                    Value="White" />

            <Setter Property="BorderBrush"
                    Value="#e2e8f0" />

            <Setter Property="BorderThickness"
                    Value="1" />

            <Setter Property="RowBackground"
                    Value="White" />

            <Setter Property="AlternatingRowBackground"
                    Value="#f8fafc" />

            <Setter Property="MaxHeight"
                    Value="240" />

            <Setter Property="HorizontalAlignment"
                    Value="Stretch" />

            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch" />

            <Setter Property="CanUserResizeRows"
                    Value="False" />

        </Style>


        <!-- ============================= -->
        <!-- Child Grid Header -->
        <!-- ============================= -->

        <Style x:Key="ChildGridColumnHeader"
               TargetType="DataGridColumnHeader">

            <Setter Property="Background"
                    Value="#f8fafc" />

            <Setter Property="Foreground"
                    Value="#334155" />

            <Setter Property="FontWeight"
                    Value="SemiBold" />

            <Setter Property="FontSize"
                    Value="14" />

            <Setter Property="Height"
                    Value="40" />

            <Setter Property="HorizontalContentAlignment"
                    Value="Left" />

            <Setter Property="VerticalContentAlignment"
                    Value="Center" />

            <Setter Property="Padding"
                    Value="12,0" />

            <Setter Property="BorderBrush"
                    Value="#e2e8f0" />

            <Setter Property="BorderThickness"
                    Value="0,0,0,1" />

        </Style>


        <!-- ============================= -->
        <!-- Child Grid Cell -->
        <!-- ============================= -->

        <Style x:Key="ChildGridCell"
               TargetType="DataGridCell">

            <Setter Property="Padding"
                    Value="10,6" />

            <Setter Property="VerticalAlignment"
                    Value="Center" />

            <Setter Property="HorizontalAlignment"
                    Value="Stretch" />

            <Setter Property="BorderBrush"
                    Value="#e2e8f0" />

            <Setter Property="BorderThickness"
                    Value="0" />

            <Setter Property="FontSize"
                    Value="12" />

            <Setter Property="Foreground"
                    Value="#334155" />

        </Style>


        <!-- ============================= -->
        <!-- Child Grid Row -->
        <!-- ============================= -->

        <Style x:Key="ChildGridRow"
               TargetType="DataGridRow">

            <Setter Property="Height"
                    Value="36" />

            <Setter Property="Background"
                    Value="White" />

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="#f8fafc" />

                </Trigger>

                <Trigger Property="IsSelected"
                         Value="True">

                    <Setter Property="Background"
                            Value="#ecfeff" />

                </Trigger>

            </Style.Triggers>

        </Style>


        <!-- ================================================= -->
        <!-- EXPANDED SALES ORDER DETAILS -->
        <!-- ================================================= -->

        <DataTemplate x:Key="OrderDetailsTemplate">

            <Border Background="#f8fafc"
                    Padding="18,14,18,18"
                    BorderBrush="#e2e8f0"
                    BorderThickness="0,1,0,0">

                <StackPanel>


                    <!-- ============================= -->
                    <!-- Details Header -->
                    <!-- ============================= -->

                    <Grid Margin="0,0,0,14">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>


                        <StackPanel>

                            <TextBlock Text="Sales Order Details"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#0f172a" />

                            <TextBlock Text="{Binding SONumber,
                                                       StringFormat=Order {0}}"
                                       FontSize="12"
                                       Foreground="#64748b"
                                       Margin="0,3,0,0" />

                        </StackPanel>


                        <!-- Status -->

                        <Border Grid.Column="1"
                                Background="{Binding Status,
                                    Converter={StaticResource StatusToColorConverter}}"
                                CornerRadius="12"
                                Padding="12,5"
                                VerticalAlignment="Center">

                            <TextBlock Text="{Binding Status}"
                                       Foreground="White"
                                       FontSize="11"
                                       FontWeight="SemiBold" />

                        </Border>

                    </Grid>


                    <!-- ============================= -->
                    <!-- Summary -->
                    <!-- ============================= -->

                    <Border Background="White"
                            CornerRadius="8"
                            Padding="12"
                            BorderBrush="#e2e8f0"
                            BorderThickness="1"
                            Margin="0,0,0,12">

                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />

                            </Grid.ColumnDefinitions>


                            <!-- SO Number -->

                            <StackPanel Grid.Column="0"
                                        Margin="0,0,12,0">

                                <TextBlock Text="SO NUMBER"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="#94a3b8" />

                                <TextBlock Text="{Binding SONumber}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#0d9488"
                                           Margin="0,3,0,0" />

                            </StackPanel>


                            <!-- Supplier -->

                            <StackPanel Grid.Column="1"
                                        Margin="0,0,12,0">

                                <TextBlock Text="SUPPLIER"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="#94a3b8" />

                                <TextBlock Text="{Binding SupplierName}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#1e293b"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,3,0,0" />

                            </StackPanel>


                            <!-- Order Date -->

                            <StackPanel Grid.Column="2"
                                        Margin="0,0,12,0">

                                <TextBlock Text="ORDER DATE"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="#94a3b8" />

                                <TextBlock Text="{Binding OrderDate,
                                                           StringFormat=dd/MM/yyyy}"
                                           FontSize="13"
                                           Foreground="#1e293b"
                                           Margin="0,3,0,0" />

                            </StackPanel>


                            <!-- Delivery -->

                            <StackPanel Grid.Column="3"
                                        Margin="0,0,12,0">

                                <TextBlock Text="DELIVERY"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="#94a3b8" />

                                <TextBlock Text="{Binding ExpectedDeliveryDate,
                                                           StringFormat=dd/MM/yyyy}"
                                           FontSize="13"
                                           Foreground="#1e293b"
                                           Margin="0,3,0,0" />

                            </StackPanel>


                            <!-- Total -->

                            <StackPanel Grid.Column="4">

                                <TextBlock Text="TOTAL AMOUNT"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="#94a3b8" />

                                <TextBlock Text="{Binding TotalAmount,
                                                           StringFormat={}{0:C}}"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="#0d9488"
                                           Margin="0,3,0,0" />

                            </StackPanel>

                        </Grid>

                    </Border>


                    <!-- ============================= -->
                    <!-- Additional Information -->
                    <!-- ============================= -->

                    <Grid Margin="0,0,0,12">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />

                        </Grid.ColumnDefinitions>


                        <!-- Payment Terms -->

                        <Border Grid.Column="0"
                                Background="#f1f5f9"
                                CornerRadius="6"
                                Padding="10"
                                Margin="0,0,6,0">

                            <StackPanel>

                                <TextBlock Text="PAYMENT TERMS"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="#64748b" />

                                <TextBlock Text="{Binding PaymentTerms,
                                                           FallbackValue=N/A}"
                                           FontSize="12"
                                           Foreground="#334155"
                                           Margin="0,3,0,0" />

                            </StackPanel>

                        </Border>


                        <!-- Delivery Terms -->

                        <Border Grid.Column="1"
                                Background="#f1f5f9"
                                CornerRadius="6"
                                Padding="10"
                                Margin="3,0,3,0">

                            <StackPanel>

                                <TextBlock Text="DELIVERY TERMS"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="#64748b" />

                                <TextBlock Text="{Binding DeliveryTerms,
                                                           FallbackValue=N/A}"
                                           FontSize="12"
                                           Foreground="#334155"
                                           Margin="0,3,0,0" />

                            </StackPanel>

                        </Border>


                        <!-- Items -->

                        <Border Grid.Column="2"
                                Background="#f1f5f9"
                                CornerRadius="6"
                                Padding="10"
                                Margin="6,0,0,0">

                            <StackPanel>

                                <TextBlock Text="ITEMS"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="#64748b" />

                                <TextBlock Text="{Binding SalesOrderItems.Count}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#334155"
                                           Margin="0,3,0,0" />

                            </StackPanel>

                        </Border>

                    </Grid>


                    <!-- ============================= -->
                    <!-- Remarks -->
                    <!-- ============================= -->

                    <Border Background="#fffbeb"
                            BorderBrush="#fde68a"
                            BorderThickness="1"
                            CornerRadius="7"
                            Padding="10"
                            Margin="0,0,0,12"
                            Visibility="{Binding Remarks,
                                Converter={StaticResource BooleanToVisibilityConverter}}">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>


                            <TextBlock Text="📝"
                                       FontSize="14"
                                       Margin="0,0,8,0" />


                            <TextBlock Grid.Column="1"
                                       Text="{Binding Remarks}"
                                       TextWrapping="Wrap"
                                       FontSize="12"
                                       Foreground="#92400e" />

                        </Grid>

                    </Border>


                    <!-- ============================= -->
                    <!-- Items Header -->
                    <!-- ============================= -->

                    <Grid Margin="0,0,0,7">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>


                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="Order Items"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#0f172a" />


                            <Border Background="#e0f2fe"
                                    CornerRadius="10"
                                    Padding="8,2"
                                    Margin="8,0,0,0">

                                <TextBlock Text="{Binding SalesOrderItems.Count}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="#0369a1" />

                            </Border>

                        </StackPanel>


                        <TextBlock Grid.Column="1"
                                   Text="Itemized order details"
                                   FontSize="11"
                                   Foreground="#94a3b8"
                                   VerticalAlignment="Center" />

                    </Grid>


                    <!-- ================================================= -->
                    <!-- NESTED ITEMS GRID -->
                    <!-- ================================================= -->

                    <Border Background="White"
                            CornerRadius="8"
                            BorderBrush="#dbe3ec"
                            BorderThickness="1">

                        <DataGrid ItemsSource="{Binding SalesOrderItems}"
                                  Style="{StaticResource ChildDataGrid}"
                                  GridLinesVisibility="None"
                                  HeadersVisibility="Column"
                                  BorderThickness="0"
                                  MaxHeight="240"
                                  CanUserResizeRows="False"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow">


                            <DataGrid.Resources>


                                <!-- ============================= -->
                                <!-- NESTED GRID HEADER -->
                                <!-- ============================= -->

                                <Style TargetType="DataGridColumnHeader"
                                       BasedOn="{StaticResource ChildGridColumnHeader}">

                                    <Setter Property="Background"
                                            Value="#f8fafc" />

                                    <Setter Property="Foreground"
                                            Value="#334155" />

                                    <Setter Property="FontWeight"
                                            Value="SemiBold" />

                                    <Setter Property="FontSize"
                                            Value="14" />

                                    <Setter Property="Height"
                                            Value="40" />

                                    <Setter Property="Padding"
                                            Value="12,0" />

                                    <Setter Property="HorizontalContentAlignment"
                                            Value="Left" />

                                    <Setter Property="VerticalContentAlignment"
                                            Value="Center" />

                                    <Setter Property="BorderThickness"
                                            Value="0,0,0,1" />

                                    <Setter Property="BorderBrush"
                                            Value="#e2e8f0" />

                                </Style>


                                <!-- ============================= -->
                                <!-- NESTED GRID CELL -->
                                <!-- ============================= -->

                                <Style TargetType="DataGridCell"
                                       BasedOn="{StaticResource ChildGridCell}">

                                    <Setter Property="Padding"
                                            Value="10,6" />

                                    <Setter Property="FontSize"
                                            Value="12" />

                                    <Setter Property="Foreground"
                                            Value="#334155" />

                                    <Setter Property="BorderThickness"
                                            Value="0" />

                                    <Setter Property="VerticalAlignment"
                                            Value="Center" />

                                </Style>


                                <!-- ============================= -->
                                <!-- NESTED GRID ROW -->
                                <!-- ============================= -->

                                <Style TargetType="DataGridRow"
                                       BasedOn="{StaticResource ChildGridRow}">

                                    <Setter Property="Height"
                                            Value="36" />

                                    <Setter Property="Background"
                                            Value="White" />

                                    <Style.Triggers>

                                        <Trigger Property="IsMouseOver"
                                                 Value="True">

                                            <Setter Property="Background"
                                                    Value="#f8fafc" />

                                        </Trigger>

                                        <Trigger Property="IsSelected"
                                                 Value="True">

                                            <Setter Property="Background"
                                                    Value="#ecfeff" />

                                        </Trigger>

                                    </Style.Triggers>

                                </Style>

                            </DataGrid.Resources>


                            <!-- ============================= -->
                            <!-- NESTED GRID COLUMNS -->
                            <!-- ============================= -->

                            <DataGrid.Columns>


                                <!-- Drug Name -->

                                <DataGridTextColumn Header="Drug Name"
                                                    Binding="{Binding Drug.DrugName}"
                                                    Width="2.5*" />


                                <!-- Batch -->

                                <DataGridTextColumn Header="Batch"
                                                    Binding="{Binding BatchNumber}"
                                                    Width="110" />


                                <!-- Quantity -->

                                <DataGridTextColumn Header="Qty"
                                                    Binding="{Binding Quantity}"
                                                    Width="60" />


                                <!-- Pending -->

                                <DataGridTextColumn Header="Pending"
                                                    Binding="{Binding PendingQuantity}"
                                                    Width="75" />


                                <!-- Received -->

                                <DataGridTextColumn Header="Received"
                                                    Binding="{Binding ReceivedQuantity}"
                                                    Width="80" />


                                <!-- Unit Price -->

                                <DataGridTextColumn Header="Unit Price"
                                                    Binding="{Binding UnitPrice,
                                                        StringFormat={}{0:C}}"
                                                    Width="100" />


                                <!-- Discount -->

                                <DataGridTextColumn Header="Discount"
                                                    Binding="{Binding DiscountPercentage,
                                                        StringFormat={}{0}%}"
                                                    Width="80" />


                                <!-- Tax -->

                                <DataGridTextColumn Header="Tax"
                                                    Binding="{Binding TaxRate,
                                                        StringFormat={}{0}%}"
                                                    Width="65" />


                                <!-- Total -->

                                <DataGridTextColumn Header="Total"
                                                    Binding="{Binding TotalAmount,
                                                        StringFormat={}{0:C}}"
                                                    Width="110" />

                            </DataGrid.Columns>

                        </DataGrid>

                    </Border>

                </StackPanel>

            </Border>

        </DataTemplate>

    </UserControl.Resources>


    <!-- ===================================================== -->
    <!-- MAIN SALES ORDER CARD -->
    <!-- ===================================================== -->

    <Border Style="{StaticResource DashboardCard}">

        <Grid>

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />

            </Grid.RowDefinitions>


            <!-- ============================= -->
            <!-- Title -->
            <!-- ============================= -->

            <StackPanel Grid.Row="0"
                        Orientation="Horizontal"
                        Margin="0,0,0,15">

                <TextBlock Text="📋"
                           FontSize="22"
                           Margin="0,0,10,0" />

                <TextBlock Text="Sales Orders"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}"
                           VerticalAlignment="Center" />


                <Border Background="{StaticResource PrimaryBrush}"
                        CornerRadius="10"
                        Padding="10,3"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center">

                    <TextBlock x:Name="OrderCountText"
                               Text="0"
                               Foreground="White"
                               FontSize="13"
                               FontWeight="Bold" />

                </Border>

            </StackPanel>


            <!-- ============================= -->
            <!-- Search / Filter -->
            <!-- ============================= -->

            <Grid Grid.Row="1"
                  Margin="0,0,0,15">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />

                </Grid.ColumnDefinitions>


                <!-- Search -->

                <TextBox x:Name="SearchBox"
                         Grid.Column="0"
                         Width="350"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Center"
                         Height="38"
                         FontSize="14"
                         Style="{StaticResource BpmTextBox}"
                         TextChanged="SearchBox_TextChanged">

                    <TextBox.ToolTip>
                        <ToolTip Content="Search by SO Number or Supplier" />
                    </TextBox.ToolTip>

                </TextBox>


                <!-- Status -->

                <ComboBox x:Name="StatusFilter"
                          Grid.Column="1"
                          Width="160"
                          Margin="10,0,0,0"
                          VerticalAlignment="Center"
                          Height="38"
                          FontSize="14"
                          Style="{StaticResource BpmComboBox}"
                          SelectionChanged="StatusFilter_SelectionChanged">

                    <ComboBoxItem Tag="All"
                                  Content="📋 All Statuses"
                                  IsSelected="True" />

                    <ComboBoxItem Tag="Draft"
                                  Content="📄 Draft" />

                    <ComboBoxItem Tag="Submitted"
                                  Content="📤 Submitted" />

                    <ComboBoxItem Tag="Confirmed"
                                  Content="✅ Confirmed" />

                    <ComboBoxItem Tag="Shipped"
                                  Content="🚚 Shipped" />

                    <ComboBoxItem Tag="Delivered"
                                  Content="📦 Delivered" />

                    <ComboBoxItem Tag="Cancelled"
                                  Content="❌ Cancelled" />

                </ComboBox>


                <!-- Refresh -->

                <Button Grid.Column="2"
                        Style="{StaticResource SocialButton}"
                        Background="{StaticResource PrimaryBrush}"
                        Foreground="White"
                        Width="38"
                        Height="38"
                        Margin="10,0,0,0"
                        Click="Refresh_Click"
                        ToolTip="Refresh">

                    <TextBlock Text="🔄"
                               FontSize="20" />

                </Button>

            </Grid>


            <!-- ================================================= -->
            <!-- MAIN SALES ORDER GRID -->
            <!-- ================================================= -->

            <DataGrid x:Name="SalesOrdersGrid"
                      Grid.Row="2"
                      AutoGenerateColumns="False"
                      CanUserSortColumns="True"
                      CanUserResizeColumns="True"
                      CanUserReorderColumns="True"
                      HeadersVisibility="Column"
                      RowHeaderWidth="0"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto"
                      Margin="0,0,0,10"
                      Background="White"
                      BorderBrush="#e2e8f0"
                      BorderThickness="1"
                      RowBackground="White"
                      AlternatingRowBackground="#f8fafc"
                      LoadingRow="SalesOrdersGrid_LoadingRow"
                      MouseDoubleClick="SalesOrdersGrid_MouseDoubleClick"
                      RowDetailsVisibilityMode="Collapsed"
                      RowDetailsTemplate="{StaticResource OrderDetailsTemplate}">


                <DataGrid.Resources>


                    <!-- Parent Header -->

                    <Style TargetType="DataGridColumnHeader">

                        <Setter Property="Background"
                                Value="#f1f5f9" />

                        <Setter Property="Foreground"
                                Value="#1e293b" />

                        <Setter Property="FontWeight"
                                Value="Bold" />

                        <Setter Property="FontSize"
                                Value="14" />

                        <Setter Property="Height"
                                Value="44" />

                        <Setter Property="HorizontalContentAlignment"
                                Value="Left" />

                        <Setter Property="Padding"
                                Value="10,0" />

                        <Setter Property="BorderBrush"
                                Value="#e2e8f0" />

                        <Setter Property="BorderThickness"
                                Value="0,0,1,1" />

                    </Style>


                    <!-- Parent Cell -->

                    <Style TargetType="DataGridCell">

                        <Setter Property="Padding"
                                Value="10,8" />

                        <Setter Property="VerticalAlignment"
                                Value="Center" />

                        <Setter Property="BorderBrush"
                                Value="#e2e8f0" />

                        <Setter Property="BorderThickness"
                                Value="0,0,1,0" />

                        <Setter Property="FontSize"
                                Value="14" />

                    </Style>


                    <!-- Parent Row -->

                    <Style TargetType="DataGridRow">

                        <Setter Property="Height"
                                Value="48" />

                        <Style.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter Property="Background"
                                        Value="#f1f5f9" />

                                <Setter Property="Cursor"
                                        Value="Hand" />

                            </Trigger>

                            <Trigger Property="IsSelected"
                                     Value="True">

                                <Setter Property="Background"
                                        Value="#e0f2fe" />

                            </Trigger>

                        </Style.Triggers>

                    </Style>

                </DataGrid.Resources>


                <!-- ============================= -->
                <!-- Parent Columns -->
                <!-- ============================= -->

                <DataGrid.Columns>


                    <!-- Expand -->

                    <DataGridTemplateColumn Header=""
                                            Width="45">

                        <DataGridTemplateColumn.CellTemplate>

                            <DataTemplate>

                                <Button Width="30"
                                        Height="30"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Click="ExpandRow_Click"
                                        Tag="{Binding Id}"
                                        ToolTip="Expand / Collapse">

                                    <TextBlock x:Name="ExpandIcon"
                                               Text="▶"
                                               FontSize="16"
                                               Foreground="#64748b"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />

                                </Button>

                            </DataTemplate>

                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>


                    <!-- SO Number -->

                    <DataGridTextColumn Header="SO Number"
                                        Binding="{Binding SONumber}"
                                        Width="*" />


                    <!-- Supplier -->

                    <DataGridTextColumn Header="Supplier"
                                        Binding="{Binding SupplierName}"
                                        Width="*" />


                    <!-- Order Date -->

                    <DataGridTextColumn Header="Order Date"
                                        Binding="{Binding OrderDate,
                                            StringFormat=dd/MM/yyyy}"
                                        Width="*" />


                    <!-- Expected Delivery -->

                    <DataGridTextColumn Header="Expected Delivery"
                                        Binding="{Binding ExpectedDeliveryDate,
                                            StringFormat=dd/MM/yyyy}"
                                        Width="*" />


                    <!-- Total -->

                    <DataGridTextColumn Header="Total Amount"
                                        Binding="{Binding TotalAmount,
                                            StringFormat={}{0:C}}"
                                        Width="*" />


                    <!-- Sub Total -->

                    <DataGridTextColumn Header="Sub Total"
                                        Binding="{Binding SubTotal,
                                            StringFormat={}{0:C}}"
                                        Width="*" />


                    <!-- Tax -->

                    <DataGridTextColumn Header="Tax"
                                        Binding="{Binding TaxAmount,
                                            StringFormat={}{0:C}}"
                                        Width="*" />


                    <!-- Discount -->

                    <DataGridTextColumn Header="Discount"
                                        Binding="{Binding DiscountAmount,
                                            StringFormat={}{0:C}}"
                                        Width="*" />


                    <!-- Items -->

                    <DataGridTextColumn Header="Items"
                                        Binding="{Binding SalesOrderItems.Count}"
                                        Width="*" />


                    <!-- Status -->

                    <DataGridTemplateColumn Header="Status"
                                            Width="*">

                        <DataGridTemplateColumn.CellTemplate>

                            <DataTemplate>

                                <Border CornerRadius="12"
                                        Padding="10,5"
                                        HorizontalAlignment="Center"
                                        Background="{Binding Status,
                                            Converter={StaticResource StatusToColorConverter}}">

                                    <TextBlock Text="{Binding Status}"
                                               Foreground="White"
                                               FontSize="13"
                                               FontWeight="SemiBold" />

                                </Border>

                            </DataTemplate>

                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>

                </DataGrid.Columns>

            </DataGrid>


            <!-- ============================= -->
            <!-- Pagination -->
            <!-- ============================= -->

            <Border Grid.Row="3"
                    Background="#f8fafc"
                    CornerRadius="8"
                    Padding="12">

                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />

                    </Grid.ColumnDefinitions>


                    <!-- Records -->

                    <TextBlock x:Name="RecordsInfo"
                               Text="Showing 0 of 0 records"
                               FontSize="14"
                               Foreground="#64748b"
                               VerticalAlignment="Center" />


                    <!-- Pagination -->

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal">


                        <!-- Previous -->

                        <Button x:Name="PreviousPageButton"
                                Content="◀"
                                Style="{StaticResource SocialButton}"
                                Background="Transparent"
                                Foreground="#475569"
                                Width="38"
                                Height="38"
                                FontSize="16"
                                Click="PreviousPage_Click"
                                ToolTip="Previous Page" />


                        <!-- Page -->

                        <TextBlock x:Name="PageInfo"
                                   Text="1 / 1"
                                   FontSize="14"
                                   Foreground="#64748b"
                                   VerticalAlignment="Center"
                                   Margin="10,0" />


                        <!-- Next -->

                        <Button x:Name="NextPageButton"
                                Content="▶"
                                Style="{StaticResource SocialButton}"
                                Background="Transparent"
                                Foreground="#475569"
                                Width="38"
                                Height="38"
                                FontSize="16"
                                Click="NextPage_Click"
                                ToolTip="Next Page" />

                    </StackPanel>

                </Grid>

            </Border>

        </Grid>

    </Border>

</UserControl>