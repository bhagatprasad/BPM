<!-- Views/Shared/FooterControl.xaml -->
<UserControl x:Class="BPM.Web.Operations.UI.Views.Shared.FooterControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:BPM.Web.Operations.UI.Views.Shared"
             mc:Ignorable="d"
             d:DesignHeight="50" d:DesignWidth="1200">

    <Border Background="{StaticResource WhiteBrush}"
            BorderBrush="#e2e8f0"
            BorderThickness="0,1,0,0"
            Padding="20,10">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="© 2026 BPM Medicals. All rights reserved."
                       FontSize="12"
                       Foreground="#94a3b8"
                       VerticalAlignment="Center" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBlock Text="Version 1.0.0"
                           FontSize="12"
                           Foreground="#94a3b8"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>