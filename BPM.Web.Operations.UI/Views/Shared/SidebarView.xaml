<!-- Views/Shared/SidebarView.xaml -->
<UserControl x:Class="BPM.Web.Operations.UI.Views.Shared.SidebarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol">

    <Border Style="{StaticResource DashboardSidebar}">
        <StackPanel>
            <!-- Logo -->
            <Border Height="70" Padding="20,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🏥" FontSize="28" Margin="0,0,8,0" />
                    <StackPanel>
                        <TextBlock Text="BPM Medicals" 
                                   FontSize="18" 
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrush}" />
                        <TextBlock Text="Healthcare Solutions"
                                   FontSize="10"
                                   Foreground="#94a3b8" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Height="1" Background="#e2e8f0" Margin="20,0" />

            <!-- Menu Items -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                <StackPanel>
                    <!-- Dashboard -->
                    <Button x:Name="DashboardMenu" 
                            Style="{StaticResource SidebarMenuItem}"
                            Click="Menu_Click"
                            Tag="Dashboard">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📊" FontSize="16" Margin="0,0,8,0" />
                            <TextBlock Text="Dashboard" />
                        </StackPanel>
                    </Button>

                    <!-- Orders -->
                    <Button x:Name="OrdersMenu" 
                            Style="{StaticResource SidebarMenuItem}"
                            Click="Menu_Click"
                            Tag="Orders">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🛒" FontSize="16" Margin="0,0,8,0" />
                            <TextBlock Text="Orders" />
                        </StackPanel>
                    </Button>

                    <!-- Purchase Orders Submenu -->
                    <StackPanel Margin="20,0,0,0">
                        <Button x:Name="PurchaseOrdersMenu"
                                Style="{StaticResource SidebarMenuItem}"
                                Click="Menu_Click"
                                Tag="PurchaseOrders"
                                Height="35"
                                FontSize="13">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📋" FontSize="14" Margin="0,0,8,0" />
                                <TextBlock Text="Purchase Orders" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="SalesOrdersMenu"
                                Style="{StaticResource SidebarMenuItem}"
                                Click="Menu_Click"
                                Tag="SalesOrders"
                                Height="35"
                                FontSize="13">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🛍️" FontSize="14" Margin="0,0,8,0" />
                                <TextBlock Text="Sales Orders" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Users -->
                    <Button x:Name="UsersMenu" 
                            Style="{StaticResource SidebarMenuItem}"
                            Click="Menu_Click"
                            Tag="Users">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👥" FontSize="16" Margin="0,0,8,0" />
                            <TextBlock Text="Users" />
                        </StackPanel>
                    </Button>

                    <!-- Dealers -->
                    <Button x:Name="DealersMenu" 
                            Style="{StaticResource SidebarMenuItem}"
                            Click="Menu_Click"
                            Tag="Dealers">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🏪" FontSize="16" Margin="0,0,8,0" />
                            <TextBlock Text="Dealers" />
                        </StackPanel>
                    </Button>

                    <!-- Drugs -->
                    <Button x:Name="DrugsMenu" 
                            Style="{StaticResource SidebarMenuItem}"
                            Click="Menu_Click"
                            Tag="Drugs">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💊" FontSize="16" Margin="0,0,8,0" />
                            <TextBlock Text="Drugs" />
                        </StackPanel>
                    </Button>

                    <!-- Separator -->
                    <Border Height="1" Background="#e2e8f0" Margin="20,10" />

                    <!-- Core -->
                    <Button x:Name="CoreMenu" 
                            Style="{StaticResource SidebarMenuItem}"
                            Click="Menu_Click"
                            Tag="Core">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙️" FontSize="16" Margin="0,0,8,0" />
                            <TextBlock Text="Core" />
                        </StackPanel>
                    </Button>

                    <!-- Chat -->
                    <Button x:Name="ChatMenu" 
                            Style="{StaticResource SidebarMenuItem}"
                            Click="Menu_Click"
                            Tag="Chat">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💬" FontSize="16" Margin="0,0,8,0" />
                            <TextBlock Text="Chat" />
                        </StackPanel>
                    </Button>

                    <!-- Email -->
                    <Button x:Name="EmailMenu" 
                            Style="{StaticResource SidebarMenuItem}"
                            Click="Menu_Click"
                            Tag="Email">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✉️" FontSize="16" Margin="0,0,8,0" />
                            <TextBlock Text="Email" />
                        </StackPanel>
                    </Button>

                    <!-- Separator -->
                    <Border Height="1" Background="#e2e8f0" Margin="20,10" />

                    <!-- Logout -->
                    <Button x:Name="LogoutMenu" 
                            Style="{StaticResource SidebarMenuItem}"
                            Click="Logout_Click"
                            Tag="Logout">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🚪" FontSize="16" Margin="0,0,8,0" />
                            <TextBlock Text="Logout" Foreground="#ef4444" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </StackPanel>
    </Border>
</UserControl>