<!-- Views/Shared/SidebarView.xaml -->
<UserControl x:Class="BPM.Web.Operations.UI.Views.Shared.SidebarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             Background="White"
             Width="250">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Logo -->
        <Border Grid.Row="0" 
                Height="80" 
                Background="#0d9488"
                Padding="20,0,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🏥" FontSize="28" Margin="0,0,10,0"/>
                <StackPanel>
                    <TextBlock Text="BPM Medicals" 
                               FontSize="18" 
                               FontWeight="Bold" 
                               Foreground="White"/>
                    <TextBlock Text="Dashboard" 
                               FontSize="12" 
                               Foreground="#e2e8f0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Menu Items -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Background="#f8fafc">
            <StackPanel Margin="0,5">
                <!-- Dashboard -->
                <Button x:Name="DashboardBtn" 
                        Style="{StaticResource SidebarMenuItem}"
                        Content="📊 Dashboard"
                        Tag="Dashboard"
                        Click="MenuItem_Click"/>

                <Border Background="#f1f5f9" Height="1" Margin="15,5"/>

                <!-- Orders (Main Menu) -->
                <Button x:Name="OrdersBtn" 
                        Style="{StaticResource SidebarMenuItem}"
                        Content="📋 Orders"
                        Tag="Orders"
                        Click="MenuItem_Click"/>

                <!-- Orders Sub-items -->
                <Button x:Name="PurchaseOrdersBtn" 
                        Style="{StaticResource SidebarSubMenuItem}"
                        Content="📥 Purchase Orders"
                        Tag="PurchaseOrders"
                        Click="MenuItem_Click"/>

                <Button x:Name="SalesOrdersBtn" 
                        Style="{StaticResource SidebarSubMenuItem}"
                        Content="📤 Sales Orders"
                        Tag="SalesOrders"
                        Click="MenuItem_Click"/>

                <Border Background="#f1f5f9" Height="1" Margin="15,5"/>

                <!-- Users -->
                <Button x:Name="UsersBtn" 
                        Style="{StaticResource SidebarMenuItem}"
                        Content="👥 Users"
                        Tag="Users"
                        Click="MenuItem_Click"/>

                <!-- Dealers -->
                <Button x:Name="DealersBtn" 
                        Style="{StaticResource SidebarMenuItem}"
                        Content="🏪 Dealers"
                        Tag="Dealers"
                        Click="MenuItem_Click"/>

                <!-- Drugs -->
                <Button x:Name="DrugsBtn" 
                        Style="{StaticResource SidebarMenuItem}"
                        Content="💊 Drugs"
                        Tag="Drugs"
                        Click="MenuItem_Click"/>

                <Border Background="#f1f5f9" Height="1" Margin="15,5"/>

                <!-- Distributor (Main Menu) -->
                <Button x:Name="DistributorBtn" 
                        Style="{StaticResource SidebarMenuItem}"
                        Content="🏢 Distributor"
                        Tag="Distributor"
                        Click="MenuItem_Click"/>

                <!-- Distributor Sub-items -->
                <Button x:Name="DistributorListBtn" 
                        Style="{StaticResource SidebarSubMenuItem}"
                        Content="📋 Distributor List"
                        Tag="DistributorList"
                        Click="MenuItem_Click"/>

                <Button x:Name="WarehouseBtn" 
                        Style="{StaticResource SidebarSubMenuItem}"
                        Content="🏭 Warehouse"
                        Tag="Warehouse"
                        Click="MenuItem_Click"/>

                <Button x:Name="InventoryBtn" 
                        Style="{StaticResource SidebarSubMenuItem}"
                        Content="📦 Inventory"
                        Tag="Inventory"
                        Click="MenuItem_Click"/>

                <Button x:Name="StockMovementsBtn" 
                        Style="{StaticResource SidebarSubMenuItem}"
                        Content="🔄 Stock Movements"
                        Tag="StockMovements"
                        Click="MenuItem_Click"/>

                <Border Background="#f1f5f9" Height="1" Margin="15,5"/>

                <!-- Core (Main Menu) -->
                <Button x:Name="CoreBtn" 
                        Style="{StaticResource SidebarMenuItem}"
                        Content="⚙️ Core"
                        Tag="Core"
                        Click="MenuItem_Click"/>

                <!-- Core Sub-items -->
                <Button x:Name="FeaturesBtn" 
                        Style="{StaticResource SidebarSubMenuItem}"
                        Content="🔧 Features"
                        Tag="Features"
                        Click="MenuItem_Click"/>

                <Button x:Name="ActivityBtn" 
                        Style="{StaticResource SidebarSubMenuItem}"
                        Content="📊 Activity"
                        Tag="Activity"
                        Click="MenuItem_Click"/>

                <Button x:Name="RolesBtn" 
                        Style="{StaticResource SidebarSubMenuItem}"
                        Content="👤 Roles"
                        Tag="Roles"
                        Click="MenuItem_Click"/>

                <Button x:Name="BatchBtn" 
                        Style="{StaticResource SidebarSubMenuItem}"
                        Content="📦 Batch"
                        Tag="Batch"
                        Click="MenuItem_Click"/>

                <Border Background="#f1f5f9" Height="1" Margin="15,5"/>

                <!-- Chat -->
                <Button x:Name="ChatBtn" 
                        Style="{StaticResource SidebarMenuItem}"
                        Content="💬 Chat"
                        Tag="Chat"
                        Click="MenuItem_Click"/>

                <!-- Email -->
                <Button x:Name="EmailBtn" 
                        Style="{StaticResource SidebarMenuItem}"
                        Content="✉️ Email"
                        Tag="Email"
                        Click="MenuItem_Click"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Logout -->
        <Border Grid.Row="2" 
                Background="#f8fafc" 
                BorderBrush="#e2e8f0" 
                BorderThickness="0,1,0,0">
            <Button x:Name="LogoutBtn" 
                    Style="{StaticResource SidebarMenuItem}"
                    Content="🚪 Logout"
                    Tag="Logout"
                    Click="LogoutBtn_Click"
                    Margin="0,5"/>
        </Border>
    </Grid>
</UserControl>