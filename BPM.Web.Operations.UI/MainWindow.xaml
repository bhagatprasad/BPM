<Window x:Class="BPM.Web.Operations.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Title="BPM Medicals - Login"
        Height="800" 
        Width="1200"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Grid>
        <!-- Background -->
        <Border Background="{StaticResource LoginBackgroundGradient}" />

        <!-- Simple Login Card -->
        <Border Style="{StaticResource BpmCard}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="500">
            <StackPanel VerticalAlignment="Center">

                <!-- Logo -->
                <TextBlock Text="🏥 BPM Medicals"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="{StaticResource PrimaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10" />

                <TextBlock Text="Welcome Back!"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}"
                           HorizontalAlignment="Center" />

                <TextBlock Text="Sign in to continue"
                           FontSize="13"
                           Foreground="{StaticResource TextLightBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,5,0,30" />

                <!-- Email -->
                <TextBox x:Name="EmailTextBox"
                         Style="{StaticResource BpmTextBox}"
                         Margin="0,0,0,15"
                         Text="admin@bpm.com" />

                <!-- Password -->
                <PasswordBox x:Name="PasswordBox"
                             Style="{StaticResource BpmPasswordBox}"
                             Margin="0,0,0,15" />

                <!-- Remember Me -->
                <CheckBox x:Name="RememberMeCheck"
          Content="Remember me"
          Style="{StaticResource BpmCheckBox}"
          Margin="0,0,0,20" />

                <!-- Login Button -->
                <Button x:Name="LoginButton"
                        Style="{StaticResource BpmPrimaryButton}"
                        Content="Sign In"
                        Click="LoginButton_Click" />

                <!-- Error Message -->
                <TextBlock x:Name="ErrorMessage"
                           Foreground="{StaticResource DangerBrush}"
                           FontSize="13"
                           HorizontalAlignment="Center"
                           Margin="0,10,0,0"
                           Visibility="Collapsed" />
            </StackPanel>
        </Border>
    </Grid>
</Window>