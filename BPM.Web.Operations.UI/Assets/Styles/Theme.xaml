<!-- Assets/Styles/Theme.xaml -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:hc="https://handyorg.github.io/handycontrol">

    <!-- Primary Colors - BPM Medical Theme -->
    <Color x:Key="PrimaryColor">#0d9488</Color>
    <Color x:Key="PrimaryDarkColor">#0e7490</Color>
    <Color x:Key="PrimaryLightColor">#ccfbf1</Color>
    <Color x:Key="SecondaryColor">#1e293b</Color>
    <Color x:Key="BackgroundColor">#f8fafc</Color>
    <Color x:Key="TextColor">#1e293b</Color>
    <Color x:Key="TextLightColor">#64748b</Color>
    <Color x:Key="WhiteColor">#ffffff</Color>
    <Color x:Key="DangerColor">#ef4444</Color>
    <Color x:Key="SuccessColor">#22c55e</Color>
    <Color x:Key="WarningColor">#f59e0b</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDarkColor}" />
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryLightColor}" />
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource SecondaryColor}" />
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="TextLightBrush" Color="{StaticResource TextLightColor}" />
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource WhiteColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />

    <!-- Gradient Brushes -->
    <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="{StaticResource PrimaryColor}" />
        <GradientStop Offset="1" Color="{StaticResource PrimaryDarkColor}" />
    </LinearGradientBrush>

    <!-- Opacity baked into ARGB hex instead of a GradientStop.Opacity attribute (which doesn't exist) -->
    <LinearGradientBrush x:Key="PrimaryLightGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#260d9488" />
        <GradientStop Offset="1" Color="#140e7490" />
    </LinearGradientBrush>

    <!-- Login Background Gradient -->
    <LinearGradientBrush x:Key="LoginBackgroundGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#0d9488" />
        <GradientStop Offset="1" Color="#0e7490" />
    </LinearGradientBrush>
</ResourceDictionary>